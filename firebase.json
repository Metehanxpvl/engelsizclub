{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "site": "engelsizclub-e5842",
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/bilgi-kutuphanesi/premature-bebek",
        "destination": "/bilgi-kutuphanesi/premature-bebek/index.html"
      },
      {
        "source": "/bilgi-kutuphanesi/premature-bebek/**",
        "destination": "/bilgi-kutuphanesi/premature-bebek/index.html"
      },
      {
        "source": "/bilgi-kutuphanesi/premature-bebek-gelisimi",
