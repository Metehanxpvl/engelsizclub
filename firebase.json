      },
      {
        "source": "/bilgi-kutuphanesi/premature-bebek-gelisimi/**",
        "destination": "/bilgi-kutuphanesi/premature-bebek-gelisimi/index.html"
      },
      {
        "source": "/bilgi-kutuphanesi/0-2-yas-gelisim-rehberi",
        "destination": "/bilgi-kutuphanesi/0-2-yas-gelisim-rehberi/index.html"
